---
layout: null
permalink: /sitemap.xml
---
{%- comment -%}
  The site's pages at their canonical URLs, as their <link rel="canonical"> has them: the courses' notes, and the pages with
  a template of their own (each has a permalink; the redirects and the .txt exports don't), but not the 404
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in site.pages %}
  {%- if page.course %}
  <url><loc>{{ site.url }}{{ page.url | replace: '.html', '' }}</loc></url>
  {%- elsif page.permalink and page.url != '/404.html' and page.url != '/sitemap.xml' %}
  <url><loc>{{ site.url }}{{ page.url | replace: '/index.html', '/' }}</loc></url>
  {%- endif %}
{%- endfor %}
</urlset>
