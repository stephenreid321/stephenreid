<div class="mb-3">
  <div class="form-row">
    <div class="form-group col-md-2 mb-2">
      <label for="x-axis-selector">X-axis</label>
      <%= select_tag :x_axis, options: [['Cost per task', 'cost'], ['Time per task', 'time'], ['Cost × time', 'cost_time']], selected: (params[:x_axis] || 'cost'), id: 'x-axis-selector', class: 'form-control' %>
    </div>
    <div class="form-group col-md-2 mb-2">
      <label for="reasoning-filter">Reasoning</label>
      <%= select_tag :reasoning, options: [
        ['All', ''],
        ['Yes', 'reasoning'],
        ['No', 'non-reasoning']
      ], selected: params[:reasoning], id: 'reasoning-filter', class: 'form-control' %>
    </div>
    <div class="form-group col-md-2 mb-2">
      <label for="open-source-filter">Open source</label>
      <%= select_tag :open_source, options: [
        ['All', ''],
        ['Yes', 'yes'],
        ['No', 'no']
      ], selected: params[:open_source], id: 'open-source-filter', class: 'form-control' %>
    </div>
    <div class="form-group col-md-2 mb-2">
      <label for="release-filter">Released in last</label>
      <%= select_tag :release, options: [['All time', '']] + [1, 3, 6, 12, 24].map { |m| ["#{pluralize(m, 'month')}", m.to_s] }, selected: (params[:release] || '3'), id: 'release-filter', class: 'form-control' %>
    </div>
  </div>
  <div class="form-row">
    <div class="form-group col-md-12 mb-2">
      <div class="d-flex flex-wrap align-items-end gap-3">
        <div class="form-group mb-1 mr-2">
          <label for="min-model-selector">At least as intelligent as</label>
          <select name="min_model_slug" id="min-model-selector" class="form-control form-control-sm" style="width: 11rem; max-width: 100%"></select>
        </div>
        <div class="form-group mb-1 mr-1">
          <button type="button" class="btn btn-sm btn-outline-secondary toggle-score-field" data-attr="intelligence">
            Intelligence &gt;=
          </button>
          <div id="score-field-intelligence" style="display: none;">
            <div class="input-group input-group-sm">
              <div class="input-group-prepend">
                <span class="btn btn-sm btn-outline-secondary" id="label-intelligence" style="cursor: pointer;">
                  Intelligence &gt;=
                </span>
              </div>
              <%= number_field_tag :min_score_intelligence, value: params[:min_score_intelligence], id: 'min-score-intelligence', class: 'form-control form-control-sm', step: 0.1, style: 'max-width: 4rem' %>
            </div>
          </div>
        </div>
        <div class="form-group mb-1 mr-2">
          <label for="max-model-selector">At least as cheap as</label>
          <select name="max_model_slug" id="max-model-selector" class="form-control form-control-sm" style="width: 11rem; max-width: 100%"></select>
        </div>
        <div class="form-group mb-1 mr-1">
          <button type="button" class="btn btn-sm btn-outline-secondary toggle-cap-field" data-cap="cost">
            Cost &le;
          </button>
          <div id="cap-field-cost" style="display: none;">
            <div class="input-group input-group-sm">
              <div class="input-group-prepend">
                <span class="btn btn-sm btn-outline-secondary" id="cap-label-cost" style="cursor: pointer;">
                  Cost &le;
                </span>
              </div>
              <%= number_field_tag :max_cost, value: params[:max_cost], id: 'max-cost-filter', class: 'form-control form-control-sm', step: 'any', min: 0, style: 'max-width: 5rem' %>
            </div>
          </div>
        </div>
        <div class="form-group mb-1 mr-2">
          <label for="fast-model-selector">At least as fast as</label>
          <select name="fast_model_slug" id="fast-model-selector" class="form-control form-control-sm" style="width: 11rem; max-width: 100%"></select>
        </div>
        <div class="form-group mb-1 mr-1">
          <button type="button" class="btn btn-sm btn-outline-secondary toggle-cap-field" data-cap="time">
            Time &le;
          </button>
          <div id="cap-field-time" style="display: none;">
            <div class="input-group input-group-sm">
              <div class="input-group-prepend">
                <span class="btn btn-sm btn-outline-secondary" id="cap-label-time" style="cursor: pointer;">
                  Time &le;
                </span>
              </div>
              <%= number_field_tag :max_time, value: params[:max_time], id: 'max-time-filter', class: 'form-control form-control-sm', step: 'any', min: 0, style: 'max-width: 4.5rem' %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="mb-4">
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0" id="chart-title"></h5>
      <button id="reset-zoom" class="btn btn-sm btn-outline-secondary">Reset zoom</button>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-12 col-lg-9">
          <div style="position: relative; height: 400px;">
            <canvas id="cost-intelligence-chart"></canvas>
          </div>
        </div>
        <div class="col-12 col-lg-3 mt-3 mt-lg-0">
          <div id="pareto-list" class="mt-2">Loading...</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="table-responsive">
  <table id="models-table" class="table">
    <thead>
      <tr>
        <th>Model</th>
        <th>Creator</th>
        <th>Release</th>
        <th>Reasoning</th>
        <th>Open source</th>
        <% @index_attributes.each do |attr| %>
          <th><%= attr.titleize %></th>
        <% end %>
        <th>Time per task</th>
        <th>Cost per task</th>
        <th>Cost × time</th>
      </tr>
    </thead>
    <tbody>
      <% @models.each do |model| %>
        <tr data-slug="<%= model['slug'] %>">
          <td>
            <strong><a href="https://artificialanalysis.ai/models/<%= model['slug'] %>" target="_blank" class="text-dark"><%= model['name'].gsub(/\s*\(Reasoning\)\s*/i, '').gsub(/\s*\(Non-reasoning\)\s*/i, '').strip %></a><% if model['reasoning_model'] %> ▲<% end %></strong>
            <br>
            <small class="text-muted"><code><%= model['slug'] %></code></small>
          </td>
          <td>
            <%= model.dig('model_creators', 'name') || 'N/A' %>
          </td>
          <td data-order="<%= model['release_date'] || '0000-00-00' %>"><%= display_or_dash(model['release_date']) { |d| Date.parse(d).strftime('%b %Y') rescue d } %></td>
          <td><%= bool_badge(model['reasoning_model'], yes_text: 'Reasoning', no_text: 'Non-reasoning') %></td>
          <td><%= bool_badge(model['is_open_weights']) %></td>
          <% @index_attributes.each do |attr| %>
            <% 
              score_key = "#{attr}_index"
              score = model[score_key]
              data_order = attr == 'omniscience' ? (model[score_key] || -999) : (model[score_key] || 0)
              cell_class = "#{attr}-index-cell"
            %>
            <td data-order="<%= data_order %>" class="<%= cell_class %>">
              <% if score %>
                <%= sprintf('%.1f', score) %>
                <small class="text-muted rank-display"></small>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </td>
          <% end %>
          <td class="time-per-task-cell" data-order="<%= model['time_per_task'] || 0 %>"><%= display_or_dash(model['time_per_task']) { |t| t >= 3600 ? sprintf('%.1f h', t / 3600.0) : t >= 60 ? sprintf('%.1f min', t / 60.0) : sprintf('%.0f s', t) } %></td>
          <td class="cost-per-task-cell" data-order="<%= model['cost_per_task'] || 0 %>"><%= display_or_dash(model['cost_per_task'], format: '%.3f', prefix: '$') %></td>
          <%
            cost_time = model['cost_per_task'].to_f > 0 && model['time_per_task'].to_f > 0 ? model['cost_per_task'].to_f * model['time_per_task'].to_f : nil
          %>
          <td data-order="<%= cost_time || 0 %>"><%= display_or_dash(cost_time) { |v| (v >= 1 ? sprintf('$%.2f', v) : v >= 0.01 ? sprintf('$%.3f', v) : '$' + sprintf('%.2g', v)) + '·s' } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
  var INDEX_ATTRIBUTES = <%== @index_attributes.to_json %>;

  var modelsData = <%== @models.map { |m|
    result = {
      slug: m['slug'],
      name: m['name'],
      costPerTask: (m['cost_per_task'] || 0).to_f,
      timePerTask: (m['time_per_task'] || 0).to_f,
      reasoningModel: !!m['reasoning_model'],
      isOpenWeights: !!m['is_open_weights'],
      releaseDate: m['release_date']
    }
    @index_attributes.each do |attr|
      score_key = "#{attr}_index"
      js_prop = "#{attr.camelize(:lower)}Index"
      # Preserve null for omniscience, default to 0 for others
      result[js_prop.to_sym] = attr == 'omniscience' ? m[score_key]&.to_f : (m[score_key] || 0).to_f
    end
    result
  }.to_json %>;

  var indexLabels = <%==
    @index_attributes.map { |attr| [attr, attr.titleize] }.to_h.to_json
  %>;

  var DEFAULT_MIN_MODEL_SLUG = 'gemini-3-7-flash-low';
  var initialMinModelSlug = <%== params[:min_model_slug].to_json %>;
  var initialMaxModelSlug = <%== params[:max_model_slug].to_json %>;
  var initialFastModelSlug = <%== params[:fast_model_slug].to_json %>;
  var MIN_MODEL_SELECTOR_INTELLIGENCE_TOP_N = 200;
  var BASELINE_SCORE_ATTRIBUTES = ['intelligence'];

  $(function() {
    var table = $('#models-table').DataTable({
      paging: false,
      searching: true,
      info: false,
      order: [[2, 'desc']], // Sort by Release date descending
      columnDefs: [
        { type: 'num', targets: [5, 6, 7, 8] } // Numeric columns (intelligence + time + cost + cost×time)
      ]
    });

    // Toggle score field visibility on button click
    $('.toggle-score-field').on('click', function() {
      var attr = $(this).data('attr');
      var $button = $(this);
      var $field = $('#score-field-' + attr);
      var $input = $('#min-score-' + attr);

      // Hide any other empty fields first
      $('[id^="score-field-"]').each(function() {
        var $otherField = $(this);
        var otherAttr = $otherField.attr('id').replace('score-field-', '');
        if (otherAttr !== attr) {
          var $otherInput = $('#min-score-' + otherAttr);
          var value = $otherInput.val();
          if (!value || value.trim() === '') {
            $otherField.hide();
            $('button[data-attr="' + otherAttr + '"]').show();
          }
        }
      });

      var slug = $('#min-model-selector').val();
      if (slug && (!$input.val() || String($input.val()).trim() === '')) {
        var model = modelsData.find(function(m) { return m.slug === slug; });
        if (model) applyBaselineFromModelToField(attr, model);
      } else {
        $button.hide();
        $field.show();
      }
      $input.focus();
      updateLabelStyle(attr);
      $input.trigger('change');
    });

    // Function to update label styling based on input value
    function updateLabelStyle(attr) {
      var $input = $('#min-score-' + attr);
      var $label = $('#label-' + attr);
      var value = $input.val();

      if (value && value.trim() !== '') {
        $label.removeClass('btn-outline-secondary').addClass('btn-primary');
      } else {
        $label.removeClass('btn-primary').addClass('btn-outline-secondary');
      }
    }

    // Update label styles on input change
    $('[id^="min-score-"]').on('input change', function(e) {
      var attr = $(this).attr('id').replace('min-score-', '');
      updateLabelStyle(attr);
      if (e.type === 'input') $('#min-model-selector').val('');
    });

    // Handle label click to reset field to blank and hide
    $('[id^="label-"]').on('click', function() {
      var attr = $(this).attr('id').replace('label-', '');
      var $input = $('#min-score-' + attr);
      var $field = $('#score-field-' + attr);
      var $toggleButton = $('button[data-attr="' + attr + '"]');

      // Set field to blank
      $input.val('');

      // Hide the field container
      $field.hide();

      // Show the toggle button
      $toggleButton.show();

      // Update label style
      updateLabelStyle(attr);

      // Trigger change event to update filters
      $input.trigger('change');
    });

    function capInput(cap) {
      return cap === 'cost' ? $('#max-cost-filter') : $('#max-time-filter');
    }

    function updateCapLabelStyle(cap) {
      var $input = capInput(cap);
      var $label = $('#cap-label-' + cap);
      var value = $input.val();
      if (value && String(value).trim() !== '') {
        $label.removeClass('btn-outline-secondary').addClass('btn-primary');
      } else {
        $label.removeClass('btn-primary').addClass('btn-outline-secondary');
      }
    }

    function setCapFieldVisibility(cap, hasValue) {
      var $field = $('#cap-field-' + cap);
      var $button = $('.toggle-cap-field[data-cap="' + cap + '"]');
      if (hasValue) {
        $field.show();
        $button.hide();
      } else {
        $field.hide();
        $button.show();
      }
      updateCapLabelStyle(cap);
    }

    $('.toggle-cap-field').on('click', function() {
      var cap = $(this).data('cap');
      var $input = capInput(cap);
      var slug = cap === 'cost' ? $('#max-model-selector').val() : $('#fast-model-selector').val();
      if (slug && (!$input.val() || String($input.val()).trim() === '')) {
        var model = modelsData.find(function(m) { return m.slug === slug; });
        $input.val(cap === 'cost' ? costCapFromModel(model) : timeCapFromModel(model));
      }
      $(this).hide();
      $('#cap-field-' + cap).show();
      $input.focus();
      updateCapLabelStyle(cap);
      $input.trigger('change');
    });

    $('#max-cost-filter, #max-time-filter').on('input change', function(e) {
      var cap = this.id === 'max-cost-filter' ? 'cost' : 'time';
      updateCapLabelStyle(cap);
      if (e.type === 'input') {
        $(cap === 'cost' ? '#max-model-selector' : '#fast-model-selector').val('');
      }
    });

    $('[id^="cap-label-"]').on('click', function() {
      var cap = $(this).attr('id').replace('cap-label-', '');
      var $input = capInput(cap);
      $input.val('');
      setCapFieldVisibility(cap, false);
      $input.trigger('change');
    });

    function updateRanks() {
      updateTableScoreRanks(table, INDEX_ATTRIBUTES.map(function(attr) {
        return {
          cellClass: attr + '-index-cell',
          nanScore: attr === 'omniscience' ? -999 : 0,
          includeScore: function(score) {
            return attr === 'omniscience' ? score !== -999 : score > 0;
          }
        };
      }));
    }

    var labelPositions = [];
    var leaderLinePlugin = createLeaderLinePlugin({
      pointRadius: 12,
      shouldLabel: function(dataPoint) { return dataPoint.isPareto; },
      formatLabel: function(dataPoint) {
        return cleanModelName(dataPoint.label) + (dataPoint.reasoningModel ? ' ▲' : '');
      },
      labelPositions: labelPositions,
      getLabelMeta: function(dataPoint) { return { slug: dataPoint.slug }; }
    });

    // Initialize scatter chart
    var ctx = document.getElementById('cost-intelligence-chart').getContext('2d');
    registerScatterChartPlugins();
    var chart = new Chart(ctx, {
      type: 'scatter',
      data: { datasets: [] },
      plugins: [leaderLinePlugin],
      options: {
        responsive: true,
        maintainAspectRatio: false,
        layout: {
          padding: scatterChartLayoutPadding()
        },
        plugins: {
          datalabels: {
            display: false // Labels drawn by leaderLinePlugin
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                var point = context.raw;
                var xAxisType = $('#x-axis-selector').val();
                return cleanModelName(point.label) + ': Score ' + point.y.toFixed(1) + ', ' + formatXAxisTooltip(point.x, xAxisType);
              }
            }
          },
          legend: {
            display: true,
            position: 'bottom',
            labels: {
              usePointStyle: true,
              padding: 20,
              generateLabels: function(chart) {
                var original = Chart.defaults.plugins.legend.labels.generateLabels;
                var labels = original.call(this, chart);
                // Override colors to use solid colors from dataset metadata
                labels.forEach(function(label) {
                  var datasetIndex = label.datasetIndex;
                  var dataset = chart.data.datasets[datasetIndex];
                  if (dataset && dataset.legendColor) {
                    label.fillStyle = dataset.legendColor;
                    label.strokeStyle = dataset.legendColor;
                  }
                });
                return labels;
              }
            }
          },
          zoom: {
            pan: {
              enabled: true,
              mode: 'xy'
            },
            zoom: {
              wheel: { enabled: true },
              pinch: { enabled: true },
              mode: 'xy'
            }
          }
        },
        scales: {
          x: {
            type: 'logarithmic',
            title: { display: true, text: 'Cost per task ($)', font: { weight: 'bold' } },
            grid: { color: 'rgba(0,0,0,0.05)' }
          },
          y: {
            title: { display: true, text: 'Intelligence', font: { weight: 'bold' } },
            grid: { color: 'rgba(0,0,0,0.05)' }
          }
        },
        onClick: function(evt, elements) {
          if (elements.length > 0) {
            var element = elements[0];
            var dataset = chart.data.datasets[element.datasetIndex];
            var dataPoint = dataset.data[element.index];
            if (dataPoint.slug) {
              window.open('https://artificialanalysis.ai/models/' + dataPoint.slug, '_blank');
            }
          }
        },
        onHover: function(evt, elements) {
          // Store hover state for data points
          chart._hoveringDataPoint = elements.length > 0;
        }
      }
    });

    chart._hoveringDataPoint = false;

    bindChartLabelInteractions(
      document.getElementById('cost-intelligence-chart'),
      chart,
      labelPositions,
      function(label) {
        window.open('https://artificialanalysis.ai/models/' + label.slug, '_blank');
      }
    );

    $('#reset-zoom').on('click', function() {
      chart.resetZoom();
    });


    // Convert snake_case to camelCase (e.g., cost_per_task -> costPerTask)
    function snakeToCamel(str) {
      return str.replace(/_([a-z])/g, function(match, letter) {
        return letter.toUpperCase();
      });
    }

    function formatCost(value) {
      if (value >= 1) return '$' + value.toFixed(2);
      if (value >= 0.01) return '$' + value.toFixed(3);
      return '$' + value.toPrecision(2);
    }

    function costTimeValue(model) {
      if (!model.costPerTask || !model.timePerTask || model.timePerTask <= 0) return 0;
      return model.costPerTask * model.timePerTask;
    }

    function formatDuration(seconds) {
      if (seconds >= 3600) return (seconds / 3600).toFixed(1) + ' h';
      if (seconds >= 60) return (seconds / 60).toFixed(1) + ' min';
      return seconds.toFixed(0) + ' s';
    }

    function getXAxisValue(model, xAxisType) {
      if (xAxisType === 'cost_time') return costTimeValue(model);
      if (xAxisType === 'time') return model.timePerTask;
      return model.costPerTask;
    }

    function xAxisMeta(xAxisType) {
      if (xAxisType === 'cost_time') return { label: 'Cost × time', unit: ' ($·s/task)' };
      if (xAxisType === 'time') return { label: 'Time per task', unit: '' };
      return { label: 'Cost per task', unit: ' ($)' };
    }

    function formatXAxisValue(value, xAxisType) {
      if (xAxisType === 'cost_time') return formatCost(value) + '·s';
      if (xAxisType === 'time') return formatDuration(value);
      return formatCost(value);
    }

    function formatXAxisTooltip(value, xAxisType) {
      if (xAxisType === 'cost_time') return 'Cost×time ' + formatXAxisValue(value, xAxisType);
      if (xAxisType === 'time') return 'Time per task ' + formatXAxisValue(value, xAxisType);
      return 'Cost/task ' + formatXAxisValue(value, xAxisType);
    }

    function getIndexValue(model, indexType) {
      return model[snakeToCamel(indexType) + 'Index'];
    }

    function getMinScores() {
      var scores = {};
      INDEX_ATTRIBUTES.forEach(function(attr) {
        if (attr === 'omniscience') {
          var val = $('#min-score-' + attr).val();
          scores[attr] = val === '' || val === null ? null : parseFloat(val);
        } else {
          scores[attr] = parseFloat($('#min-score-' + attr).val()) || 0;
        }
      });
      return scores;
    }

    function getMaxCostLimit() {
      var raw = $('#max-cost-filter').val();
      if (raw === '' || raw === null) return null;
      var n = parseFloat(raw);
      if (isNaN(n) || n <= 0) return null;
      return n;
    }

    function getMaxTimeLimit() {
      var raw = $('#max-time-filter').val();
      if (raw === '' || raw === null) return null;
      var n = parseFloat(raw);
      if (isNaN(n) || n <= 0) return null;
      return n;
    }

    function resolveSlug(initialSlug, defaultSlug) {
      if (initialSlug === '') return '';
      if (initialSlug && modelsData.some(function(m) { return m.slug === initialSlug; }))
        return initialSlug;
      var d = modelsData.find(function(m) { return m.slug === defaultSlug; });
      if (d) return d.slug;
      return modelsData.length ? modelsData[0].slug : '';
    }

    function resolveBaselineSlug() {
      return resolveSlug(initialMinModelSlug, DEFAULT_MIN_MODEL_SLUG);
    }

    function resolveOptionalSlug(initialSlug) {
      if (!initialSlug) return '';
      if (modelsData.some(function(m) { return m.slug === initialSlug; })) return initialSlug;
      return '';
    }

    function resolveMaxBaselineSlug() {
      return resolveOptionalSlug(initialMaxModelSlug);
    }

    function resolveFastBaselineSlug() {
      return resolveOptionalSlug(initialFastModelSlug);
    }

    function modelsMatchingReleaseFilter() {
      var releaseFilter = $('#release-filter').val();
      if (!releaseFilter) return modelsData.slice();
      var cutoffDate = new Date();
      cutoffDate.setMonth(cutoffDate.getMonth() - parseInt(releaseFilter));
      return modelsData.filter(function(model) {
        if (!model.releaseDate) return false;
        return new Date(model.releaseDate) >= cutoffDate;
      });
    }

    function populateModelSelector($sel, desired, useFallback) {
      $sel.empty();
      $sel.append($('<option></option>').attr('value', '').text(''));

      var ranked = modelsMatchingReleaseFilter().sort(function(a, b) {
        return (b.intelligenceIndex || 0) - (a.intelligenceIndex || 0);
      });
      var fallbackSlug = ranked.length ? ranked[0].slug : '';
      var optionsList = ranked.slice(0, MIN_MODEL_SELECTOR_INTELLIGENCE_TOP_N);
      var inSelect = {};
      optionsList.forEach(function(m) { inSelect[m.slug] = true; });

      if (desired && !inSelect[desired]) {
        var extra = ranked.find(function(m) { return m.slug === desired; });
        if (extra) optionsList.push(extra);
      }

      optionsList.sort(function(a, b) {
        return cleanModelName(a.name).localeCompare(cleanModelName(b.name), undefined, { sensitivity: 'base' });
      });

      optionsList.forEach(function(m) {
        var label = cleanModelName(m.name) + (m.reasoningModel ? ' ▲' : '');
        $sel.append($('<option></option>').attr('value', m.slug).text(label));
      });

      $sel.val(desired);
      if (desired && $sel.val() !== desired) {
        $sel.val(useFallback && fallbackSlug ? fallbackSlug : '');
      }
    }

    function populateMinModelSelector() {
      var current = $('#min-model-selector').val();
      populateModelSelector($('#min-model-selector'), current || resolveBaselineSlug(), !current);
    }

    function populateMaxModelSelector() {
      populateModelSelector($('#max-model-selector'), $('#max-model-selector').val() || resolveMaxBaselineSlug(), false);
    }

    function populateFastModelSelector() {
      populateModelSelector($('#fast-model-selector'), $('#fast-model-selector').val() || resolveFastBaselineSlug(), false);
    }

    function costCapFromModel(model) {
      var c = model && model.costPerTask;
      if (!c || c <= 0 || isNaN(c)) return '';
      return (Math.ceil(c * 10000) / 10000).toString();
    }

    function setMaxCostFromBaseline(slug, onlyIfEmpty) {
      var $input = $('#max-cost-filter');
      if (!slug) {
        if (!onlyIfEmpty) {
          $input.val('');
          setCapFieldVisibility('cost', false);
        }
        return;
      }
      if (onlyIfEmpty) {
        var existing = $input.val();
        if (existing != null && String(existing).trim() !== '') {
          setCapFieldVisibility('cost', true);
          return;
        }
      }
      var model = modelsData.find(function(m) { return m.slug === slug; });
      $input.val(costCapFromModel(model));
      setCapFieldVisibility('cost', !!$input.val());
    }

    function applyMaxModelBaseline(slug) {
      setMaxCostFromBaseline(slug, false);
      table.draw();
      updateRanks();
      updateChart();
    }

    function timeCapFromModel(model) {
      var t = model && model.timePerTask;
      if (!t || t <= 0 || isNaN(t)) return '';
      return (Math.ceil(t * 10) / 10).toString();
    }

    function setMaxTimeFromBaseline(slug, onlyIfEmpty) {
      var $input = $('#max-time-filter');
      if (!slug) {
        if (!onlyIfEmpty) {
          $input.val('');
          setCapFieldVisibility('time', false);
        }
        return;
      }
      if (onlyIfEmpty) {
        var existing = $input.val();
        if (existing != null && String(existing).trim() !== '') {
          setCapFieldVisibility('time', true);
          return;
        }
      }
      var model = modelsData.find(function(m) { return m.slug === slug; });
      $input.val(timeCapFromModel(model));
      setCapFieldVisibility('time', !!$input.val());
    }

    function applyFastModelBaseline(slug) {
      setMaxTimeFromBaseline(slug, false);
      table.draw();
      updateRanks();
      updateChart();
    }

    function clearMinScoreFieldsFromBaseline() {
      BASELINE_SCORE_ATTRIBUTES.forEach(function(attr) {
        var $field = $('#score-field-' + attr);
        var $button = $('.toggle-score-field[data-attr="' + attr + '"]');
        var $input = $('#min-score-' + attr);
        $input.val('');
        $field.hide();
        $button.show();
        updateLabelStyle(attr);
      });
    }

    function applyBaselineFromModelToField(attr, model) {
      var $field = $('#score-field-' + attr);
      var $button = $('.toggle-score-field[data-attr="' + attr + '"]');
      var $input = $('#min-score-' + attr);

      var v = model[snakeToCamel(attr) + 'Index'];
      if (v == null || isNaN(v)) {
        $input.val('');
        $field.hide();
        $button.show();
      } else {
        $input.val(Math.floor(parseFloat(v)).toString());
        $field.show();
        $button.hide();
      }
      updateLabelStyle(attr);
    }

    function showPrefilledMinScoreFields() {
      INDEX_ATTRIBUTES.forEach(function(attr) {
        var $input = $('#min-score-' + attr);
        if ($input.val() != null && String($input.val()).trim() !== '') {
          $('#score-field-' + attr).show();
          $('.toggle-score-field[data-attr="' + attr + '"]').hide();
          updateLabelStyle(attr);
        }
      });
    }

    function setMinScoreFieldsFromBaseline(slug, onlyIfEmpty) {
      if (!slug) {
        if (onlyIfEmpty) {
          showPrefilledMinScoreFields();
        } else {
          clearMinScoreFieldsFromBaseline();
        }
        return;
      }

      var model = modelsData.find(function(m) { return m.slug === slug; });
      if (!model) return;

      if (onlyIfEmpty) showPrefilledMinScoreFields();

      BASELINE_SCORE_ATTRIBUTES.forEach(function(attr) {
        if (onlyIfEmpty) {
          var $input = $('#min-score-' + attr);
          if ($input.val() != null && String($input.val()).trim() !== '') {
            $('#score-field-' + attr).show();
            $('.toggle-score-field[data-attr="' + attr + '"]').hide();
            updateLabelStyle(attr);
            return;
          }
        }
        applyBaselineFromModelToField(attr, model);
      });
    }

    function applyMinModelBaseline(slug) {
      if (!slug) {
        clearMinScoreFieldsFromBaseline();
        table.draw();
        updateRanks();
        updateChart();
        return;
      }
      setMinScoreFieldsFromBaseline(slug, false);
      table.draw();
      updateRanks();
      updateChart();
    }

    $('#min-model-selector').on('change', function() {
      applyMinModelBaseline($(this).val());
    });

    $('#max-model-selector').on('change', function() {
      applyMaxModelBaseline($(this).val());
    });

    $('#fast-model-selector').on('change', function() {
      applyFastModelBaseline($(this).val());
    });

    function updateChart() {
      var selectedIndex = INDEX_ATTRIBUTES[0];
      var xAxisType = $('#x-axis-selector').val();
      var reasoningFilter = $('#reasoning-filter').val();
      var openSourceFilter = $('#open-source-filter').val();
      var releaseFilter = $('#release-filter').val();
      var minScores = getMinScores();
      var maxCostLimit = getMaxCostLimit();
      var maxTimeLimit = getMaxTimeLimit();

      // Update title and axis labels
      var indexLabel = indexLabels[selectedIndex];
      var xMeta = xAxisMeta(xAxisType);
      $('#chart-title').text(indexLabel + ' vs ' + xMeta.label);
      chart.options.scales.y.title.text = indexLabel;
      chart.options.scales.x.title.text = xMeta.label + xMeta.unit;
      chart.options.scales.x.type = 'logarithmic';

      // Calculate cutoff date for release filter
      var cutoffDate = null;
      if (releaseFilter) {
        cutoffDate = new Date();
        cutoffDate.setMonth(cutoffDate.getMonth() - parseInt(releaseFilter));
      }

      // Filter models based on current filters
      var filteredModels = modelsData.filter(function(model) {
        var reasoningMatch = true;
        var openSourceMatch = true;
        var releaseMatch = true;

        if (reasoningFilter === 'reasoning') reasoningMatch = model.reasoningModel;
        else if (reasoningFilter === 'non-reasoning') reasoningMatch = !model.reasoningModel;

        if (openSourceFilter === 'yes') openSourceMatch = model.isOpenWeights;
        else if (openSourceFilter === 'no') openSourceMatch = !model.isOpenWeights;

        if (cutoffDate && model.releaseDate) {
          var modelDate = new Date(model.releaseDate);
          releaseMatch = modelDate >= cutoffDate;
        } else if (cutoffDate) {
          releaseMatch = false;
        }

        var indexValue = getIndexValue(model, selectedIndex);
        var xAxisValue = getXAxisValue(model, xAxisType);

        // Check all min score filters
        var scoreMatch = true;
        var indexValueMap = {};
        INDEX_ATTRIBUTES.forEach(function(attr) {
          indexValueMap[attr] = model[snakeToCamel(attr) + 'Index'];
        });

        INDEX_ATTRIBUTES.forEach(function(attr) {
          if (attr === 'omniscience') {
            if (minScores[attr] != null && indexValueMap[attr] != null && indexValueMap[attr] < minScores[attr]) {
              scoreMatch = false;
            }
          } else {
            if (minScores[attr] > 0 && indexValueMap[attr] < minScores[attr]) {
              scoreMatch = false;
            }
          }
        });

        // For omniscience, allow negative values; for others, require > 0
        var indexValueValid = selectedIndex === 'omniscience'
          ? (indexValue != null && !isNaN(indexValue))
          : (indexValue > 0);

        var costCapMatch = true;
        if (maxCostLimit != null) {
          costCapMatch = model.costPerTask <= maxCostLimit;
        }

        var timeCapMatch = true;
        if (maxTimeLimit != null) {
          timeCapMatch = model.timePerTask <= maxTimeLimit;
        }

        return reasoningMatch && openSourceMatch && releaseMatch && scoreMatch && indexValueValid && xAxisValue > 0 && costCapMatch && timeCapMatch;
      });

      // Group by reasoning and open source
      // Colors: primary green for open source, grey for closed source
      // Shapes: triangle for reasoning (like a bright idea), circle for non-reasoning
      var openColor = '#4F9DFA';
      var closedColor = '#000000';

      var groups = {
        'Reasoning + Open Source': {
          filter: function(m) { return m.reasoningModel && m.isOpenWeights; },
          color: openColor,
          pointStyle: 'triangle'
        },
        'Reasoning + Closed': {
          filter: function(m) { return m.reasoningModel && !m.isOpenWeights; },
          color: closedColor,
          pointStyle: 'triangle'
        },
        'Non-reasoning + Open Source': {
          filter: function(m) { return !m.reasoningModel && m.isOpenWeights; },
          color: openColor,
          pointStyle: 'circle'
        },
        'Non-reasoning + Closed': {
          filter: function(m) { return !m.reasoningModel && !m.isOpenWeights; },
          color: closedColor,
          pointStyle: 'circle'
        }
      };

      // Calculate Pareto frontier FIRST so we can label only those points
      var allPoints = filteredModels.map(function(m) {
        return { x: getXAxisValue(m, xAxisType), y: getIndexValue(m, selectedIndex), label: m.name, reasoningModel: m.reasoningModel, slug: m.slug };
      });

      // Sort by x-axis value (lower is better)
      allPoints.sort(function(a, b) { return a.x - b.x; });

      // Find Pareto-optimal points (with epsilon for near-ties)
      var paretoPoints = [];
      var paretoInfo = {}; // Store both membership and index
      var maxIntelligence = -Infinity;
      var maxY = allPoints.length > 0 ? Math.max.apply(null, allPoints.map(function(p) { return p.y; })) : 0;
      var epsilon = maxY * 0.02; // 2% tolerance

      for (var i = 0; i < allPoints.length; i++) {
        if (allPoints[i].y > maxIntelligence - epsilon) {
          paretoInfo[allPoints[i].label] = paretoPoints.length; // Store index
          paretoPoints.push(allPoints[i]);
          if (allPoints[i].y > maxIntelligence) {
            maxIntelligence = allPoints[i].y;
          }
        }
      }


      chart.data.datasets = [];

      Object.keys(groups).forEach(function(label) {
        var group = groups[label];
        var models = filteredModels.filter(group.filter);
        if (models.length > 0) {
          var dataPoints = models.map(function(m) {
            var pIdx = paretoInfo[m.name];
            var xValue = getXAxisValue(m, xAxisType);
            return {
              x: xValue,
              y: getIndexValue(m, selectedIndex),
              label: m.name,
              slug: m.slug,
              isPareto: pIdx !== undefined,
              paretoIndex: pIdx || 0,
              reasoningModel: m.reasoningModel
            };
          });
          chart.data.datasets.push({
            label: label,
            data: dataPoints,
            backgroundColor: dataPoints.map(function(point) {
              return group.color + (point.isPareto ? 'ff' : '33');
            }),
            legendColor: group.color, // Solid color for legend
            borderWidth: 0,
            pointStyle: group.pointStyle,
            pointRadius: 10,
            pointHoverRadius: 12,
            datalabels: { display: false }
          });
        }
      });

      // Add Pareto frontier as a line
      if (paretoPoints.length > 1) {
        chart.data.datasets.unshift({
          label: 'Pareto Frontier',
          data: paretoPoints,
          type: 'line',
          borderColor: '#ff6b6b',
          borderWidth: 2,
          borderDash: [5, 5],
          fill: false,
          pointRadius: 0,
          pointStyle: 'line',
          tension: 0,
          datalabels: { display: false }
        });
      }

      // Update Pareto list (sorted by x-axis value, highest first)
      if (paretoPoints.length > 0) {
        var sortedPareto = paretoPoints.slice().sort(function(a, b) { return b.x - a.x; });
        var paretoHtml = '<ul class="list-unstyled mb-0">' + sortedPareto.map(function(p) {
          var lightbulbIcon = p.reasoningModel ? ' ▲' : '';
          var xDisplay = formatXAxisValue(p.x, xAxisType);
          return '<li><strong><a href="https://artificialanalysis.ai/models/' + p.slug + '" target="_blank" class="text-dark">' + cleanModelName(p.label) + '</a>' + lightbulbIcon + '</strong> <span class="text-muted">(' + xDisplay + ' @ ' + p.y.toFixed(1) + ')</span></li>';
        }).join('') + '</ul>';
        $('#pareto-list').html(paretoHtml);
      } else {
        $('#pareto-list').html('<em>No models match current filters</em>');
      }

      chart.update();
    }

    // Custom filter function for table
    $.fn.dataTable.ext.search.push(
      function(settings, data, dataIndex) {
        var reasoningFilter = $('#reasoning-filter').val();
        var openSourceFilter = $('#open-source-filter').val();
        var releaseFilter = $('#release-filter').val();
        var minScores = getMinScores();
        var maxCostLimit = getMaxCostLimit();
        var maxTimeLimit = getMaxTimeLimit();

        if (settings.nTable.id !== 'models-table') return true;

        var row = table.row(dataIndex).node();
        var reasoningCell = $(row).find('td:eq(3)');
        var openSourceCell = $(row).find('td:eq(4)');

        var reasoningMatch = true;
        var openSourceMatch = true;
        var releaseMatch = true;
        var scoreMatch = true;

        if (reasoningFilter === 'reasoning') {
          reasoningMatch = reasoningCell.find('.badge-success').length > 0 && reasoningCell.text().includes('Reasoning');
        } else if (reasoningFilter === 'non-reasoning') {
          reasoningMatch = reasoningCell.find('.badge-secondary').length > 0 && reasoningCell.text().includes('Non-reasoning');
        }

        if (openSourceFilter === 'yes') {
          openSourceMatch = openSourceCell.find('.badge-success').length > 0 && openSourceCell.text().includes('Yes');
        } else if (openSourceFilter === 'no') {
          openSourceMatch = openSourceCell.find('.badge-secondary').length > 0 && openSourceCell.text().includes('No');
        }

        if (releaseFilter) {
          var cutoffDate = new Date();
          cutoffDate.setMonth(cutoffDate.getMonth() - parseInt(releaseFilter));
          var cellData = $(row).find('td:eq(2)').data('order') || '';
          if (cellData && cellData !== '0000-00-00') {
            var modelDate = new Date(cellData);
            releaseMatch = modelDate >= cutoffDate;
          } else {
            releaseMatch = false;
          }
        }

        // Check all min score filters
        var indexColIndices = {};
        INDEX_ATTRIBUTES.forEach(function(attr, idx) {
          indexColIndices[attr] = idx + 5;
        });

        INDEX_ATTRIBUTES.forEach(function(attr) {
          if (attr === 'omniscience') {
            if (minScores[attr] != null) {
              var score = parseFloat($(row).find('td:eq(' + indexColIndices[attr] + ')').data('order'));
              if (!isNaN(score) && score < minScores[attr]) scoreMatch = false;
            }
          } else {
            if (minScores[attr] > 0) {
              var score = parseFloat($(row).find('td:eq(' + indexColIndices[attr] + ')').data('order')) || 0;
              if (score < minScores[attr]) scoreMatch = false;
            }
          }
        });

        var costCapMatch = true;
        if (maxCostLimit != null) {
          var costVal = parseFloat($(row).find('td.cost-per-task-cell').data('order'));
          if (isNaN(costVal)) costVal = 0;
          costCapMatch = costVal <= maxCostLimit;
        }

        var timeCapMatch = true;
        if (maxTimeLimit != null) {
          var timeVal = parseFloat($(row).find('td.time-per-task-cell').data('order'));
          if (isNaN(timeVal)) timeVal = 0;
          timeCapMatch = timeVal <= maxTimeLimit;
        }

        return reasoningMatch && openSourceMatch && releaseMatch && scoreMatch && costCapMatch && timeCapMatch;
      }
    );

    // Populate baseline control, fill the intelligence floor from that model, then apply custom filter
    populateMinModelSelector();
    populateMaxModelSelector();
    populateFastModelSelector();
    setMinScoreFieldsFromBaseline($('#min-model-selector').val(), true);
    setMaxCostFromBaseline($('#max-model-selector').val(), true);
    setMaxTimeFromBaseline($('#fast-model-selector').val(), true);
    table.draw();

    // Apply filters when dropdowns change
    var minScoreSelectors = INDEX_ATTRIBUTES.map(function(attr) { return '#min-score-' + attr; }).join(', ');
    $('#reasoning-filter, #open-source-filter, #release-filter, #max-cost-filter, #max-time-filter, #x-axis-selector, ' + minScoreSelectors).on('change input', function() {
      if (this.id === 'release-filter') {
        populateMinModelSelector();
        populateMaxModelSelector();
        populateFastModelSelector();
      }
      table.draw();
      updateRanks();
      updateChart();
    });

    // Update ranks when table is redrawn (for search/filter changes)
    table.on('draw', function() {
      updateRanks();
    });

    // Handle window resize for mobile responsiveness
    var resizeTimer;
    $(window).on('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        chart.resize();
        updateChart();
      }, 250);
    });

    // Initial chart render and rank update
    updateRanks();
    updateChart();
  });
</script>
