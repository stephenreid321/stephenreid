<%# theme= tells the embed's CSS (the minimal head on Dandelion) which of our themes it's shown in %>
<iframe style="overflow: scroll; border: 0; height: 100vh; width: 100%;" id="<%= id %>" src="<%= src %>&theme=<%= @stylesheet %>"></iframe>
<script>
  $(function () {
    $('#<%= id %>').iFrameResize({ checkOrigin: false, heightCalculationMethod: 'taggedElement' })
    document.addEventListener('themechange', function (e) {
      const iframe = document.getElementById('<%= id %>')
      iframe.src = iframe.src.replace(/theme=\w+/, `theme=${e.detail}`)
    })
  })
</script>
