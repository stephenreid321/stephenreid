<%= partial :'artizen/board' %>

<% unless @artizen_error && @projects.blank? && @funds.blank? %>
  <table id="artizen-funds-table" class="table table-sm">
    <thead>
      <tr>
        <th>Fund</th>
        <th class="text-right">Contributions</th>
        <% if @season && @season[:current] %>
          <th class="text-right">Unlocked</th>
          <th class="text-right">Available</th>
          <th class="text-right">Raised</th>
          <th class="text-right">Prize</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @funds.each do |fund| %>
        <tr>
          <td>
            <strong><a href="<%= fund[:url] %>" class="text-dark"><%= fund[:name] %></a></strong>
            <% if fund[:subtitle] %>
              <br><small class="text-muted"><%= truncate(fund[:subtitle], length: 90) %></small>
            <% end %>
            <% if fund[:active] == false %>
              <br><span class="badge badge-secondary">Inactive</span>
            <% end %>
          </td>
          <td class="text-right" data-order="<%= fund[:season_total] %>"><%= usd(fund[:season_total]) %></td>
          <% if @season && @season[:current] %>
            <td class="text-right" data-order="<%= fund[:unlocked] || -1 %>"><%= usd(fund[:unlocked]) %></td>
            <td class="text-right" data-order="<%= fund[:available] || -1 %>"><%= usd(fund[:available]) %></td>
            <td class="text-right" data-order="<%= fund[:raised] || -1 %>"><%= usd(fund[:raised]) %></td>
            <td class="text-right" data-order="<%= fund[:prize_usd] || -1 %>">
              <% if fund[:prize_usd] %>
                <%= usd(fund[:prize_usd]) %>
              <% elsif fund[:prize_art] %>
                <%= ActiveSupport::NumberHelper.number_to_delimited(fund[:prize_art].round) %>
                <small class="text-muted">ART</small>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>

  <link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/3.1.9/css/fixedHeader.bootstrap4.min.css">
  <script src="https://cdn.datatables.net/fixedheader/3.1.9/js/dataTables.fixedHeader.min.js"></script>
  <script>
    $(function() {
      $('#artizen-funds-table').DataTable({
        paging: true,
        pageLength: 25,
        lengthMenu: [10, 25, 50, 100],
        searching: true,
        info: true,
        fixedHeader: true,
        <% if @season && @season[:current] %>
          order: [[3, 'desc']],
          columnDefs: [
            { type: 'num', targets: [1, 2, 3, 4, 5] }
          ]
        <% else %>
          order: [[1, 'desc']],
          columnDefs: [
            { type: 'num', targets: [1] }
          ]
        <% end %>
      });
    });
  </script>
<% end %>
