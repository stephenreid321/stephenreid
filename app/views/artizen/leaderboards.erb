<%= partial :'artizen/styles' %>

<div class="mb-3">
  <h2 class="regular mb-1">Artizen leaderboards</h2>
  <p class="text-muted mb-2">
    Project raised = sales + match + prize. Fund raised = unlocked + available. Season total is confirmed contributions.
    Data from <a href="https://artizen.fund/" target="_blank" rel="noopener">artizen.fund</a><% if @season && @season[:total_raised] %>
    · <%= usd(@season[:total_raised]) %> raised this season<% end %>
  </p>
  <form method="get" action="/artizen" class="form-inline">
    <label for="artizen-season" class="mr-2 mb-0">Season</label>
    <select name="season" id="artizen-season" class="form-control" onchange="this.form.submit()">
      <% @seasons.each do |season| %>
        <option value="<%= season[:number] %>" <%= 'selected' if @season && season[:number] == @season[:number] %>>
          <%= season[:title] %><%= ' (current)' if season[:current] %>
        </option>
      <% end %>
    </select>
  </form>
</div>

<% if @artizen_error && @projects.blank? && @funds.blank? %>
  <div class="alert alert-warning">
    Could not load Artizen leaderboards. Try again later or visit
    <a href="https://artizen.fund/index/leaderboard" class="alert-link" target="_blank" rel="noopener">their leaderboard</a> directly.
  </div>
<% else %>
  <ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
      <a class="nav-link active" id="projects-tab" data-toggle="tab" href="#projects" role="tab">Projects (<%= @projects.size %>)</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" id="drives-tab" data-toggle="tab" href="#drives" role="tab">Drives (<%= @drives.size %>)</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" id="funds-tab" data-toggle="tab" href="#funds" role="tab">Funds (<%= @funds.size %>)</a>
    </li>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade show active" id="projects" role="tabpanel">
      <table id="artizen-projects-table" class="table table-sm">
          <thead>
            <tr>
              <th class="text-right">#</th>
              <th>Project</th>
              <th>Creator</th>
              <th class="text-right">Sales</th>
              <th class="text-right">Match</th>
              <th class="text-right">Prize</th>
              <th class="text-right">Raised</th>
            </tr>
          </thead>
          <tbody>
            <% @projects.each do |project| %>
              <tr>
                <td class="text-right text-muted" data-order="<%= project[:rank] %>"><%= project[:rank] %></td>
                <td>
                  <strong><a href="<%= project[:url] %>" class="text-dark"><%= project[:name] %></a></strong>
                  <% if project[:logline] %>
                    <br><small class="text-muted"><%= truncate(project[:logline], length: 90) %></small>
                  <% end %>
                </td>
                <td><%= project[:creator] || %(<span class="text-muted">—</span>) %></td>
                <td class="text-right" data-order="<%= project[:sales] %>"><%= usd(project[:sales]) %></td>
                <td class="text-right" data-order="<%= project[:match] %>"><%= usd(project[:match]) %></td>
                <td class="text-right" data-order="<%= project[:prize] %>"><%= usd(project[:prize]) %></td>
                <td class="text-right" data-order="<%= project[:raised] %>"><%= usd(project[:raised]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
    </div>

    <div class="tab-pane fade" id="drives" role="tabpanel">
      <% if @drives.empty? %>
        <p class="text-muted">No fund drives in this season.</p>
      <% else %>
        <div class="row">
          <% @drives.each do |drive| %>
            <div class="col-md-6 col-xl-4 mb-3">
              <div class="card h-100">
                <% if drive[:image] %>
                  <img class="artizen-drive-thumb card-img-top" src="<%= drive[:image] %>" alt="" loading="lazy">
                <% end %>
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-start mb-1">
                    <h5 class="mb-0"><%= drive[:name] %></h5>
                    <% if drive[:active] %>
                      <span class="badge badge-success">Active</span>
                    <% else %>
                      <span class="badge badge-secondary"><%= drive[:status] %></span>
                    <% end %>
                  </div>
                  <% if drive[:multiple] %>
                    <span class="badge badge-success mb-2"><%= drive[:multiple].to_i %>x match</span>
                  <% end %>
                  <% if drive[:description] %>
                    <p class="small text-muted mb-2"><%= truncate(drive[:description], length: 140) %></p>
                  <% end %>
                  <p class="small mb-2">
                    <% if drive[:start] %><%= Time.zone.parse(drive[:start]).strftime('%d %b') %><% end %>
                    –
                    <% if drive[:end] %><%= Time.zone.parse(drive[:end]).strftime('%d %b %Y') %><% end %>
                  </p>
                  <dl class="row small mb-0">
                    <dt class="col-6">Match pot</dt>
                    <dd class="col-6 text-right"><%= usd(drive[:match_pot]) %></dd>
                    <dt class="col-6">Project prizes</dt>
                    <dd class="col-6 text-right"><%= usd(drive[:prize_projects]) %></dd>
                    <dt class="col-6">Fund prizes</dt>
                    <dd class="col-6 text-right"><%= usd(drive[:prize_funds]) %></dd>
                    <% if drive[:match_per_project] %>
                      <dt class="col-6">Match / project</dt>
                      <dd class="col-6 text-right"><%= usd(drive[:match_per_project]) %></dd>
                    <% end %>
                    <% if drive[:project_first] %>
                      <dt class="col-6">1st / 2nd / 3rd</dt>
                      <dd class="col-6 text-right"><%= usd(drive[:project_first]) %> / <%= usd(drive[:project_second]) %> / <%= usd(drive[:project_third]) %></dd>
                    <% end %>
                  </dl>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="tab-pane fade" id="funds" role="tabpanel">
      <table id="artizen-funds-table" class="table table-sm">
          <thead>
            <tr>
              <th class="text-right">#</th>
              <th>Fund</th>
              <th class="text-right">Season total</th>
              <% if @season && @season[:current] %>
                <th class="text-right">Available</th>
                <th class="text-right">Raised</th>
                <th class="text-right">Prize</th>
              <% end %>
              <th>Last contribution</th>
            </tr>
          </thead>
          <tbody>
            <% @funds.each do |fund| %>
              <tr>
                <td class="text-right text-muted" data-order="<%= fund[:rank] %>"><%= fund[:rank] %></td>
                <td>
                  <strong><a href="<%= fund[:url] %>" class="text-dark"><%= fund[:name] %></a></strong>
                  <% if fund[:active] == false %>
                    <br><span class="badge badge-secondary">Inactive</span>
                  <% end %>
                </td>
                <td class="text-right" data-order="<%= fund[:season_total] %>"><%= usd(fund[:season_total]) %></td>
                <% if @season && @season[:current] %>
                  <td class="text-right" data-order="<%= fund[:available] || -1 %>"><%= usd(fund[:available]) %></td>
                  <td class="text-right" data-order="<%= fund[:raised] || -1 %>"><%= usd(fund[:raised]) %></td>
                  <td class="text-right" data-order="<%= fund[:prize_usd] || -1 %>">
                    <% if fund[:prize_usd] %>
                      <%= usd(fund[:prize_usd]) %>
                    <% elsif fund[:prize_art] %>
                      <%= ActiveSupport::NumberHelper.number_to_delimited(fund[:prize_art].round) %>
                      <small class="text-muted">ART</small>
                    <% end %>
                  </td>
                <% end %>
                <td data-order="<%= fund[:last_contribution] || '' %>">
                  <% if fund[:last_contribution] %>
                    <%= timeago(Time.zone.parse(fund[:last_contribution])) %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
    </div>
  </div>

  <link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/3.1.9/css/fixedHeader.bootstrap4.min.css">
  <script src="https://cdn.datatables.net/fixedheader/3.1.9/js/dataTables.fixedHeader.min.js"></script>
  <script>
    $(function() {
      var tableOpts = {
        paging: true,
        pageLength: 25,
        lengthMenu: [10, 25, 50, 100],
        searching: true,
        info: true,
        order: [[0, 'asc']],
        fixedHeader: true
      };
      $('#artizen-projects-table').DataTable($.extend({
        columnDefs: [
          { type: 'num', targets: [0, 3, 4, 5, 6] }
        ]
      }, tableOpts));
      $('#artizen-funds-table').DataTable($.extend({}, tableOpts, {
        <% if @season && @season[:current] %>
          order: [[3, 'desc']],
          columnDefs: [
            { type: 'num', targets: [0, 2, 3, 4, 5] }
          ]
        <% else %>
          order: [[2, 'desc']],
          columnDefs: [
            { type: 'num', targets: [0, 2] }
          ]
        <% end %>
      }));

      $('a[data-toggle="tab"]').on('shown.bs.tab', function() {
        $.fn.dataTable.tables({ visible: true, api: true })
          .columns.adjust()
          .fixedHeader.adjust();
      });
    });
  </script>
<% end %>
