<%= partial :'artizen/styles' %>

<p class="mb-3">
  <a href="/artizen/projects">&larr; Artizen leaderboards</a>
</p>

<div class="row mb-4">
  <% if @project[:image] %>
    <div class="col-lg-4 mb-3">
      <img class="artizen-hero" src="<%= @project[:image] %>" alt="<%= @project[:name] %>">
    </div>
    <div class="col-lg-8">
    <% else %>
      <div class="col-lg-12">
      <% end %>
      <h1 class="mb-2"><%= @project[:name] %></h1>
      <% if @project[:logline] %>
        <p class="lead"><%= @project[:logline] %></p>
      <% end %>
      <% if @project[:creator] %>
        <p class="mb-2">
          <%= @project[:creator] %>
        </p>
      <% end %>
      <% @project[:tags].each do |tag| %>
        <span class="badge badge-secondary mr-1 mb-1"><%= tag %></span>
      <% end %>
      <p class="mt-2 mb-0">
        <a href="<%= @project[:artizen_url] %>" target="_blank" rel="noopener">View on Artizen</a>
      </p>
    </div>
  </div>

  <% if @project[:seasons].any? %>
    <h2 class="regular mt-4">Funding</h2>
    <div class="table-responsive mb-4">
      <table class="table table-sm artizen-funding-tree">
        <thead>
          <tr>
            <th></th>
            <th class="text-right">Sales</th>
            <th class="text-right">Venus</th>
            <th class="text-right">Match</th>
            <th class="text-right">Prize</th>
            <th class="text-right">V+M+P</th>
            <th class="text-right">(V+M+P)/S</th>
            <th class="text-right">(V+M)/S</th>
            <th class="text-right">Raised</th>
            <th class="text-right">Available</th>
          </tr>
        </thead>
        <tbody>
          <% @project[:seasons].each_with_index do |season, si| %>
            <% season_id = "s#{si}" %>
            <% season_open = si.zero? %>
            <tr class="artizen-tree-season" data-id="<%= season_id %>">
              <td>
                <% if season[:drives].any? %>
                  <a href="#" class="artizen-tree-toggle" aria-expanded="<%= season_open %>"><i class="bi <%= season_open ? 'bi-chevron-down' : 'bi-chevron-right' %>"></i></a>
                <% else %>
                  <span class="artizen-tree-toggle"></span>
                <% end %>
                <%= season[:title] %>
              </td>
              <%= artizen_money_cells(season) %>
              <td class="text-right"><%= usd(season[:available]) if season[:available].to_f.positive? %></td>
            </tr>
            <% season[:drives].each_with_index do |drive, di| %>
              <% drive_id = "#{season_id}d#{di}" %>
              <% drive_open = season_open && di.zero? %>
              <tr class="artizen-tree-drive<%= ' artizen-tree-hidden' unless season_open %>" data-id="<%= drive_id %>" data-parent="<%= season_id %>">
                <td>
                  <% if drive[:funds].any? %>
                    <a href="#" class="artizen-tree-toggle" aria-expanded="<%= drive_open %>"><i class="bi <%= drive_open ? 'bi-chevron-down' : 'bi-chevron-right' %>"></i></a>
                  <% else %>
                    <span class="artizen-tree-toggle"></span>
                  <% end %>
                <%= drive[:name] %>
                  <% if drive[:multiple] %> <span class="badge badge-primary"><%= drive[:multiple].to_i %>x</span><% end %>
                  <% if drive[:active] %> <span class="badge badge-primary">current</span><% end %>
                </td>
                <%= artizen_money_cells(drive) %>
                <td class="text-right"><%= usd(drive[:available]) if drive[:active] %></td>
              </tr>
              <% drive[:funds].each do |fund| %>
                <tr class="artizen-tree-fund<%= ' artizen-tree-hidden' unless drive_open %>" data-parent="<%= drive_id %>">
                  <td>
                    <span class="artizen-tree-toggle"></span>
                    <a href="<%= fund[:url] %>" class="text-dark"><%= fund[:name] %></a>
                  </td>
                  <td class="text-right"></td>
                  <td class="text-right"></td>
                  <td class="text-right"><%= usd(fund[:unlocked]) %></td>
                  <td class="text-right"></td>
                  <td class="text-right"></td>
                  <td class="text-right"></td>
                  <td class="text-right"></td>
                  <td class="text-right"></td>
                  <td class="text-right"><%= usd(fund[:available]) if drive[:active] %></td>
                </tr>
              <% end %>
            <% end %>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th>Total</th>
            <%= artizen_money_cells({
              sales: @project[:seasons].sum { |s| s[:sales].to_f },
              venus: @project[:seasons].sum { |s| s[:venus].to_f },
              match: @project[:seasons].sum { |s| s[:match].to_f },
              prize: @project[:seasons].sum { |s| s[:prize].to_f },
              raised: @project[:seasons].sum { |s| s[:raised].to_f }
            }, tag: 'th') %>
            <th class="text-right"><%= usd(@project[:seasons].sum { |s| s[:available].to_f }) %></th>
          </tr>
        </tfoot>
      </table>
    </div>
  <% end %>

  <% if @project[:submissions].to_a.any? %>
    <h2 class="regular mt-4">Submissions</h2>
    <div class="table-responsive mb-4">
      <table class="table table-sm artizen-funding-tree">
        <thead>
          <tr>
            <th></th>
            <th class="text-right">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @project[:submissions].group_by { |s| [s[:season_number], s[:season]] }.each_with_index do |((_, season_title), submissions), si| %>
            <% season_id = "sub#{si}" %>
            <% season_open = si.zero? %>
            <tr class="artizen-tree-season" data-id="<%= season_id %>">
              <td>
                <a href="#" class="artizen-tree-toggle" aria-expanded="<%= season_open %>"><i class="bi <%= season_open ? 'bi-chevron-down' : 'bi-chevron-right' %>"></i></a>
                <%= season_title %>
              </td>
              <td></td>
            </tr>
            <% submissions.each do |submission| %>
              <tr class="artizen-tree-submission<%= ' artizen-tree-hidden' unless season_open %>" data-parent="<%= season_id %>">
                <td>
                  <span class="artizen-tree-toggle"></span>
                  <a href="<%= submission[:url] %>" class="text-dark"><%= submission[:name] %></a>
                </td>
                <td class="text-right">
                  <% accepted = %w[Curated Approved].include?(submission[:status]) %>
                  <span class="badge <%= accepted ? 'badge-primary' : 'badge-secondary' %>"><%= submission[:status] %></span>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if @project[:video] %>
    <%= Artizen.video_iframe(@project[:video]) %>
  <% end %>

  <% { 'About' => @project[:description], 'Impact' => @project[:impact], 'Progress' => @project[:progress], 'Team' => @project[:team] }.each do |heading, body| %>
    <% if body %>
      <h2 class="regular mt-4"><%= heading %></h2>
      <%= simple_format(body) %>
    <% end %>
  <% end %>
