<%= partial :'artizen/styles' %>

<p class="mb-3">
  <a href="/artizen">&larr; Artizen leaderboards</a>
</p>

<div class="row mb-4">
  <% if @project[:image] %>
    <div class="col-lg-4 mb-3">
      <img class="artizen-hero" src="<%= @project[:image] %>" alt="<%= @project[:name] %>">
    </div>
    <div class="col-lg-8">
    <% else %>
      <div class="col-lg-12">
      <% end %>
      <h1 class="mb-2"><%= @project[:name] %></h1>
      <% if @project[:logline] %>
        <p class="lead"><%= @project[:logline] %></p>
      <% end %>
      <% if @project[:creator] %>
        <p class="mb-2">
          <%= @project[:creator] %>
        </p>
      <% end %>
      <% @project[:tags].each do |tag| %>
        <span class="badge badge-secondary mr-1 mb-1"><%= tag %></span>
      <% end %>
      <p class="mt-2 mb-0">
        <a href="<%= @project[:artizen_url] %>" target="_blank" rel="noopener">View on Artizen</a>
      </p>
    </div>
  </div>

  <% if @project[:seasons].any? %>
    <h2 class="regular mt-4">Funding</h2>
    <div class="table-responsive mb-4">
      <table class="table table-sm artizen-funding-tree">
        <thead>
          <tr>
            <th></th>
            <th class="text-right">Sales</th>
            <th class="text-right">Match</th>
            <th class="text-right">Match multiple</th>
            <th class="text-right">Available</th>
            <th class="text-right">Prize</th>
            <th class="text-right">Raised</th>
          </tr>
        </thead>
        <tbody>
          <% @project[:seasons].each_with_index do |season, si| %>
            <% season_id = "s#{si}" %>
            <% season_open = si.zero? %>
            <tr class="artizen-tree-season" data-id="<%= season_id %>">
              <td>
                <% if season[:drives].any? %>
                  <a href="#" class="artizen-tree-toggle" aria-expanded="<%= season_open %>"><i class="bi <%= season_open ? 'bi-chevron-down' : 'bi-chevron-right' %>"></i></a>
                <% else %>
                  <span class="artizen-tree-toggle"></span>
                <% end %>
                <%= season[:title] %>
              </td>
              <td class="text-right"><%= usd(season[:sales]) %></td>
              <td class="text-right"><%= usd(season[:match]) %></td>
              <td class="text-right"><%= "#{format('%.1f', season[:match] / season[:sales])}x" if season[:sales].to_f.positive? %></td>
              <td class="text-right"><%= usd(season[:available]) %></td>
              <td class="text-right"><%= usd(season[:prize]) %></td>
              <td class="text-right"><%= usd(season[:raised]) %></td>
            </tr>
            <% season[:drives].each_with_index do |drive, di| %>
              <% drive_id = "#{season_id}d#{di}" %>
              <% drive_open = season_open && di.zero? %>
              <tr class="artizen-tree-drive<%= ' artizen-tree-hidden' unless season_open %>" data-id="<%= drive_id %>" data-parent="<%= season_id %>">
                <td>
                  <% if drive[:funds].any? %>
                    <a href="#" class="artizen-tree-toggle" aria-expanded="<%= drive_open %>"><i class="bi <%= drive_open ? 'bi-chevron-down' : 'bi-chevron-right' %>"></i></a>
                  <% else %>
                    <span class="artizen-tree-toggle"></span>
                  <% end %>
                <%= drive[:name] %>
                  <% if drive[:multiple] %> <span class="badge badge-secondary"><%= drive[:multiple].to_i %>x</span><% end %>
                  <% if drive[:active] %> <span class="badge badge-success">current</span><% end %>
                </td>
                <td class="text-right"><%= usd(drive[:sales]) %></td>
                <td class="text-right"><%= usd(drive[:match]) %></td>
                <td class="text-right"><%= "#{format('%.1f', drive[:match] / drive[:sales])}x" if drive[:sales].to_f.positive? %></td>
                <td class="text-right"><%= drive[:active] ? usd(drive[:available]) : %(<span class="text-muted">—</span>) %></td>
                <td class="text-right"><%= usd(drive[:prize]) %></td>
                <td class="text-right"><%= usd(drive[:sales].to_f + drive[:match].to_f + drive[:prize].to_f) %></td>
              </tr>
              <% drive[:funds].each do |fund| %>
                <tr class="artizen-tree-fund<%= ' artizen-tree-hidden' unless drive_open %>" data-parent="<%= drive_id %>">
                  <td>
                    <span class="artizen-tree-toggle"></span>
                    <a href="<%= fund[:url] %>" class="text-dark"><%= fund[:name] %></a>
                  </td>
                  <td class="text-right"></td>
                  <td class="text-right"><%= usd(fund[:unlocked]) %></td>
                  <td class="text-right"></td>
                  <td class="text-right"><%= drive[:active] ? usd(fund[:available]) : %(<span class="text-muted">—</span>) %></td>
                  <td class="text-right"></td>
                  <td class="text-right"></td>
                </tr>
              <% end %>
              <% end %>
            <% end %>
          <% end %>
        </tbody>
        <tfoot>
          <% season_sales = @project[:seasons].sum { |s| s[:sales] } %>
          <% season_match = @project[:seasons].sum { |s| s[:match] } %>
          <tr>
            <th>Total</th>
            <th class="text-right"><%= usd(season_sales) %></th>
            <th class="text-right"><%= usd(season_match) %></th>
            <th class="text-right"><%= "#{format('%.1f', season_match / season_sales)}x" if season_sales.positive? %></th>
            <th class="text-right"><%= usd(@project[:seasons].sum { |s| s[:available].to_f }) %></th>
            <th class="text-right"><%= usd(@project[:seasons].sum { |s| s[:prize] }) %></th>
            <th class="text-right"><%= usd(@project[:seasons].sum { |s| s[:raised] }) %></th>
          </tr>
        </tfoot>
      </table>
    </div>
  <% end %>

  <% if @project[:video] %>
    <%= Artizen.video_iframe(@project[:video]) %>
  <% end %>

  <% { 'About' => @project[:description], 'Impact' => @project[:impact], 'Progress' => @project[:progress], 'Team' => @project[:team] }.each do |heading, body| %>
    <% if body %>
      <h2 class="regular mt-4"><%= heading %></h2>
      <%= simple_format(body) %>
    <% end %>
  <% end %>
