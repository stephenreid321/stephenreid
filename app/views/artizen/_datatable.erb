<script>
  $(function() {
    $('#<%= table_id %>').DataTable({
      paging: true,
      pageLength: 25,
      lengthMenu: [10, 25, 50, 100],
      searching: true,
      info: true,
      autoWidth: false,
      order: <%= order.to_json %>,
      columnDefs: [
        { type: 'num', targets: <%= Array(numeric).to_json %> }
      ]
    });
  });
</script>
