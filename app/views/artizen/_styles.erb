<style>
  .artizen-drive-thumb {
    width: 100%;
    height: 120px;
    object-fit: cover;
    background: #222;
  }
  .artizen-hero {
    width: 100%;
    max-height: 320px;
    object-fit: cover;
    border-radius: 6px;
    background: #eee;
  }
  .artizen-stat {
    background: #f7f7f7;
    border-radius: 6px;
    padding: 0.75rem 1rem;
    margin-bottom: 0.75rem;
  }
  .artizen-stat .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #888;
    margin-bottom: 0.15rem;
  }
  .artizen-stat .value {
    font-size: 1.25rem;
    font-weight: 600;
  }
  #artizen-projects-table td, #artizen-funds-table td,
  #artizen-projects-table th, #artizen-funds-table th {
    vertical-align: middle;
  }
  .artizen-tree-hidden {
    display: none !important;
  }
  .artizen-funding-tree td,
  .artizen-funding-tree th {
    vertical-align: top;
  }
  .artizen-tree-toggle {
    color: inherit;
    width: 1.15rem;
    display: inline-block;
    text-align: center;
    line-height: 1;
    vertical-align: top;
  }
  .artizen-tree-toggle:hover,
  .artizen-tree-toggle:focus {
    color: inherit;
    text-decoration: none;
  }
  .artizen-tree-label {
    display: inline-block;
    vertical-align: top;
    max-width: calc(100% - 1.4rem);
  }
  .artizen-tree-drive td:first-child {
    padding-left: 1.5rem;
  }
  .artizen-tree-fund td:first-child,
  .artizen-tree-project td:first-child {
    padding-left: 2.75rem;
  }
  .artizen-tree-adjust td {
    font-style: italic;
    color: #888;
  }
</style>
<script>
  $(function() {
    $('.artizen-funding-tree').on('click', '.artizen-tree-toggle', function(e) {
      e.preventDefault();
      var $btn = $(this);
      if (!$btn.is('a')) return;
      var $table = $btn.closest('.artizen-funding-tree');
      var $row = $btn.closest('tr');
      var id = $row.data('id');
      var expanding = $btn.attr('aria-expanded') !== 'true';
      $btn.attr('aria-expanded', expanding);
      $btn.find('i').toggleClass('bi-chevron-down', expanding).toggleClass('bi-chevron-right', !expanding);
      var $kids = $table.find('tr[data-parent="' + id + '"]');
      if (expanding) {
        $kids.removeClass('artizen-tree-hidden');
        $kids.each(function() {
          var $child = $(this);
          var childId = $child.data('id');
          var childOpen = $child.find('.artizen-tree-toggle[aria-expanded="true"]').length;
          if (childId && !childOpen) {
            $table.find('tr[data-parent="' + childId + '"]').addClass('artizen-tree-hidden');
          }
        });
      } else {
        $kids.addClass('artizen-tree-hidden');
        $kids.each(function() {
          var childId = $(this).data('id');
          if (childId) {
            $table.find('tr[data-parent="' + childId + '"]').addClass('artizen-tree-hidden');
          }
        });
      }
    });
  });
</script>
