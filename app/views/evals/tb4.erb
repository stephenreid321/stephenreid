<% if @tb4_rows.empty? %>
  <div class="alert alert-warning">
    Could not load Terminal-Bench 4.0 results from Artificial Analysis. Try again later or visit
    <a href="https://artificialanalysis.ai/evaluations/terminalbench-4-0" class="alert-link" target="_blank" rel="noopener">their leaderboard</a> directly.
  </div>
<% else %>
  <% tb4_score_column_classes = [{ cell_class: 'tb4-score-cell' }] %>
  <div class="mb-4">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
        <h5 class="mb-0">Terminal-Bench 4.0</h5>
        <div class="form-inline mt-2 mt-md-0 align-items-end">
          <div class="form-group mb-0 mr-2">
            <label for="tb4-baseline-select" class="mb-1 mr-1 d-block small text-muted">At least as smart as</label>
            <select id="tb4-baseline-select" class="form-control form-control-sm" style="min-width: 14rem; max-width: 26rem;"></select>
          </div>
          <button id="tb4-reset-zoom" class="btn btn-sm btn-outline-secondary mb-0 mt-2 mt-md-0">Reset zoom</button>
        </div>
      </div>
      <div class="card-body">
        <div style="position: relative; height: 420px;">
          <canvas id="tb4-scatter-chart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <table id="tb4-table" class="table table-sm">
    <thead>
      <tr>
        <th>Configuration</th>
        <th>Model</th>
        <th>Effort</th>
        <th>Lab</th>
        <th class="text-right">Score</th>
        <th class="text-right">Cost / task</th>
        <th class="text-right">Tasks / dollar</th>
        <th class="text-right">Output tokens / task</th>
      </tr>
    </thead>
    <tbody>
      <% @tb4_rows.each do |row| %>
        <tr>
          <td>
            <strong><%= row['displayLabel'] %></strong>
          </td>
          <td><%= row['model'] %></td>
          <td>
            <% if row['effort'].to_s.strip != '' %>
              <%= row['effort'] %>
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </td>
          <td><%= row['lab'] %></td>
          <td class="text-right tb4-score-cell" data-order="<%= (row['score'].to_f * 100).round(1) %>">
            <%= sprintf('%.1f', row['score'].to_f * 100) %>
            <small class="text-muted rank-display"></small>
          </td>
          <td class="text-right" data-order="<%= row['cost'] || -1 %>">
            <% if row['cost'] %>
              <%= sprintf('$%.2f', row['cost'].to_f) %>
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </td>
          <% tasks_per_dollar = row['cost'].to_f > 0 ? 1.0 / row['cost'].to_f : nil %>
          <td class="text-right" data-order="<%= tasks_per_dollar || -1 %>">
            <% if tasks_per_dollar %>
              <%= sprintf('%.2f', tasks_per_dollar) %>
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </td>
          <td class="text-right" data-order="<%= row['tokens'] || -1 %>">
            <% if row['tokens'] %>
              <% tokens = row['tokens'].to_f %>
              <%= tokens >= 1000 ? sprintf('%.1fk', tokens / 1000.0) : sprintf('%.1f', tokens) %>
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <script>
    var tb4ChartData = <%== @tb4_rows.map { |r|
      {
        id: r['id'],
        label: r['displayLabel'],
        lab: r['lab'],
        score: r['score']&.to_f,
        cost: r['cost'],
        tokens: r['tokens']
      }
    }.to_json %>;

    var TB4_SCORE_COLUMNS = <%== tb4_score_column_classes.map { |c| { cellClass: c[:cell_class] } }.to_json %>;
    var TB4_NUMERIC_TARGETS = [4, 5, 6, 7];
    var DEFAULT_TB4_BASELINE_LABEL = 'Claude Opus 5.5 (low with fallback)';
    var DEFAULT_TB4_BASELINE_PREFIX = 'Claude Opus 5.5 (low with fallback)';

    var labColors = <%== @lab_colors.to_json %>;

    $(function() {
      var tb4Table = $('#tb4-table').DataTable({
        paging: false,
        searching: true,
        info: true,
        dom: "<'d-flex justify-content-end mb-2'f><'table-responsive'tr><'row'<'col-sm-12'i>>",
        order: [[4, 'desc']],
        columnDefs: [
          { className: 'text-right', targets: TB4_NUMERIC_TARGETS },
          { type: 'num', targets: TB4_NUMERIC_TARGETS }
        ]
      });

      function updateTb4ScoreRanks() {
        updateTableScoreRanks(tb4Table, TB4_SCORE_COLUMNS);
      }

      tb4Table.on('draw', function() {
        updateTb4ScoreRanks();
      });
      updateTb4ScoreRanks();

      function scoreDisplay(row) {
        if (row.score == null || isNaN(row.score)) return null;
        return Math.round(row.score * 1000) / 10;
      }

      function populateTb4BaselineSelect() {
        var $sel = $('#tb4-baseline-select');
        $sel.empty();
        $sel.append($('<option></option>').attr('value', '').text(''));
        tb4ChartData.slice().filter(function(r) {
          return scoreDisplay(r) != null;
        }).sort(function(a, b) {
          var da = scoreDisplay(a);
          var db = scoreDisplay(b);
          if (db !== da) return da - db;
          return a.label.localeCompare(b.label, undefined, { sensitivity: 'base' });
        }).forEach(function(r) {
          $sel.append(
            $('<option></option>')
              .attr('value', r.id)
              .text(r.label + ' (' + scoreDisplay(r).toFixed(1) + ')')
          );
        });
        var defaultRow = tb4ChartData.find(function(r) {
          return r.label === DEFAULT_TB4_BASELINE_LABEL;
        }) || tb4ChartData.find(function(r) {
          return r.label.indexOf(DEFAULT_TB4_BASELINE_PREFIX) === 0;
        });
        $sel.val(defaultRow ? defaultRow.id : '');
      }

      function baselineMinScore() {
        var id = $('#tb4-baseline-select').val();
        if (!id) return null;
        var base = tb4ChartData.find(function(r) { return String(r.id) === String(id); });
        if (!base) return null;
        return scoreDisplay(base);
      }

      $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
        if (settings.nTable.id !== 'tb4-table') return true;

        var floor = baselineMinScore();
        if (floor == null) return true;

        var row = tb4Table.row(dataIndex).node();
        var score = parseFloat($(row).find('td.tb4-score-cell').data('order'));
        if (isNaN(score) || score < 0) return false;
        return score >= floor;
      });

      function applyTb4BaselineFilter() {
        tb4Table.draw();
        rebuildChart();
      }

      populateTb4BaselineSelect();
      tb4Table.draw();

      var scatterChart = null;

      function formatTokens(tokens) {
        if (tokens >= 1000) return (tokens / 1000).toFixed(1) + 'k';
        return tokens.toFixed(1);
      }

      function rebuildChart() {
        if (!scatterChart) return;
        var floor = baselineMinScore();
        var byLab = {};
        tb4ChartData.forEach(function(row) {
          var scoreDisp = scoreDisplay(row);
          if (scoreDisp == null) return;
          if (floor != null && scoreDisp < floor) return;
          var cost = row.cost;
          var tokens = row.tokens;
          if (cost == null || tokens == null || cost <= 0 || tokens <= 0) return;
          var lab = row.lab || 'Other';
          if (!byLab[lab]) byLab[lab] = [];
          byLab[lab].push({
            x: tokens,
            y: 1 / cost,
            label: row.label,
            tooltip: row.label +
              ': score ' + scoreDisp.toFixed(1) +
              ', ' + (1 / cost).toFixed(2) + ' tasks/dollar' +
              ', $' + cost.toFixed(2) +
              ', ' + formatTokens(tokens) + ' tokens'
          });
        });

        scatterChart.data.datasets = Object.keys(byLab).sort().map(function(lab) {
          return {
            label: lab,
            data: byLab[lab],
            backgroundColor: hexToRgba(labColors[lab]),
            pointRadius: 7,
            pointHoverRadius: 9,
            datalabels: { display: false }
          };
        });
        scatterChart.update();
      }

      var ctx = document.getElementById('tb4-scatter-chart');
      if (ctx && tb4ChartData.length) {
        var leaderLinePlugin = createLeaderLinePlugin({ pointRadius: 10 });

        registerScatterChartPlugins();
        scatterChart = new Chart(ctx.getContext('2d'), {
          type: 'scatter',
          data: { datasets: [] },
          plugins: [leaderLinePlugin],
          options: {
            responsive: true,
            maintainAspectRatio: false,
            layout: {
              padding: scatterChartLayoutPadding()
            },
            plugins: {
              datalabels: {
                display: false
              },
              tooltip: {
                callbacks: {
                  label: function(ctx) {
                    var p = ctx.raw;
                    return p.tooltip;
                  }
                }
              },
              legend: {
                display: true,
                position: 'bottom'
              },
              zoom: {
                limits: {
                  x: { min: 0 },
                  y: { min: 0 }
                },
                pan: {
                  enabled: true,
                  mode: 'xy'
                },
                zoom: {
                  wheel: { enabled: true },
                  pinch: { enabled: true },
                  mode: 'xy'
                }
              }
            },
            scales: {
              x: {
                min: 0,
                reverse: true,
                title: { display: true, text: 'Output tokens / task' },
                ticks: {
                  callback: function(v) {
                    if (v >= 1000) return (v / 1000).toFixed(0) + 'k';
                    return v;
                  }
                }
              },
              y: {
                min: 0,
                title: { display: true, text: 'Tasks / dollar' },
                ticks: {
                  callback: function(v) {
                    return v >= 10 ? v.toFixed(0) : v.toFixed(2);
                  }
                }
              }
            }
          }
        });
      }

      $('#tb4-baseline-select').on('change', applyTb4BaselineFilter);

      $('#tb4-reset-zoom').on('click', function() {
        if (scatterChart) scatterChart.resetZoom();
      });

      rebuildChart();
    });
  </script>
<% end %>
