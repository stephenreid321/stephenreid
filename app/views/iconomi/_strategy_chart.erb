<% spin = 180 / actual.count %>
<script>
  $(function () {
    var config = {
      type: 'doughnut',
      data: {
        datasets: [{
            data: <%= actual.values %>,
            backgroundColor: <%= actual.keys.map do |k|
              asset = Asset.find_by(ticker: k)
              asset.color ? "##{asset.color}" : asset.virtual_color
            end %>
          }],
        labels: <%= actual.keys %>
      },
      options: {
        plugins: {
          legend: {
            display: true
          },
          tooltip: {
            callbacks: {
              label: function (tooltipItem) {
                try {
                  let label = ' ' + tooltipItem.label || '';
                  if (label) {
                    label += ': ';
                  }

                  const sum = tooltipItem.dataset.data.reduce((accumulator, curValue) => {
                    return accumulator + curValue;
                  });
                  const value = tooltipItem.raw;
                  label += Number((value / sum) * 100).toFixed(1) + '%';
                  return label;
                } catch (error) {
                  console.log(error);
                }
              }
            }
          }
        }
      }
    };
    $(function() {
      var ctx = document.getElementById('chart-area').getContext('2d');
      window.myPie = new Chart(ctx, config);
    })
  })
</script>
<canvas id="chart-area"></canvas>
