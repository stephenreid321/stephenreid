<link rel="preconnect" href="https://cdn.jsdelivr.net">

<% FRONTEND_DEPENDENCIES.each do |package, files| %>
  <% files.split.each do |f| %>
    <%= cdn_tag package, f, **(FRONTEND_MODULES.include?(package) ? { type: 'module' } : {}) %>
  <% end %>
<% end %>
<% FRONTEND_URLS.each do |url| %>
  <%= cdn_tag url %>
<% end %>

<script src="/javascripts/app.js?<%= @cachebuster %>"></script>
