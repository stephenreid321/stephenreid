#!/usr/bin/env ruby
# Runs our linters, each on the files of its kind. CI's lint job (.github/workflows/lint.yml) runs it too, so this is the
# one place their commands and flags are set:
#
#   script/lint FILE...     the files as they are on disk
#   script/lint --staged    the staged version of each staged file (the pre-commit hook in .githooks)
#   script/lint --all       everything, as CI does
#
# Add --only <linter> (rubocop, eslint, stylelint, zizmor, actionlint, shellcheck or lint_test) to run just one, as CI's
# separate steps do. A changed linter config runs that linter on everything, as CI would. lint_test (test/lint_test.rb,
# the rules no linter checks) reads the whole checkout, so it runs as a whole whenever a file it checks changes. Exits
# non-zero if any linter fails.
require 'open3'

$stdout.sync = true # so the summary on stderr comes after the output
Dir.chdir(File.expand_path('..', __dir__))

QUIET = { 'RUBYOPT' => '-W0' }.freeze # hides the parser gem's warnings about Ruby versions it doesn't know

LINTERS = [
  {
    name: 'RuboCop',
    files: %r{\.(rb|rake|ru)\z|\A(Gemfile|Rakefile)\z|\Ascript/lint\z},
    configs: /\A\.rubocop\.yml\z/,
    command: %w[bundle exec rubocop --force-exclusion],
    stdin: ->(file) { ['--stdin', file] },
    env: QUIET
  },
  {
    name: 'ESLint',
    files: %r{\A(site/javascripts|cloudflare)/.+\.js\z},
    configs: /\A(eslint\.config\.mjs|package(-lock)?\.json)\z/,
    command: %w[npx --no-install eslint --no-warn-ignored],
    all: %w[site/javascripts cloudflare],
    stdin: ->(file) { ['--stdin', '--stdin-filename', file] },
    node: true
  },
  {
    # GitHub Actions workflows, and the composite actions they share. uvx runs this exact version, so none arrives
    # unchosen; with GH_TOKEN set (as in CI) it runs its online audits too
    name: 'zizmor',
    files: %r{\A\.github/(workflows/.+|actions/.+/action)\.ya?ml\z},
    configs: %r{\A(\.github/)?zizmor\.ya?ml\z},
    command: %w[uvx zizmor@1.31.1 --quiet --no-progress],
    all: ['.'],
    stdin: ->(_file) { ['-'] },
    uv: true
  },
  {
    # What zizmor doesn't check: that the workflows are right (expressions, needs, runs-on, inputs), and the shell in
    # each run: block, with ShellCheck. Only workflows: it doesn't read composite actions
    name: 'actionlint',
    files: %r{\A\.github/workflows/.+\.ya?ml\z},
    configs: %r{\A\.github/actionlint\.ya?ml\z},
    command: %w[uvx --from actionlint-py==1.7.12.25 --with shellcheck-py==0.11.0.1 actionlint -no-color],
    all: [], # it finds the workflows itself
    stdin: ->(file) { ['-stdin-filename', file, '-'] },
    uv: true
  },
  {
    name: 'ShellCheck',
    files: %r{\A(.+\.sh|\.githooks/.+)\z},
    configs: /\A\.shellcheckrc\z/,
    command: %w[uvx --from shellcheck-py==0.11.0.1 shellcheck],
    all: -> { `git ls-files -z -- '*.sh' .githooks`.split("\0") },
    stdin: ->(_file) { ['-'] },
    uv: true
  },
  {
    name: 'Stylelint',
    files: %r{\Asite/stylesheets/.+\.scss\z},
    configs: /\A(stylelint\.config\.mjs|package(-lock)?\.json)\z/,
    command: %w[npx --no-install stylelint --allow-empty-input],
    all: ['site/stylesheets/*.scss'],
    stdin: ->(file) { ['--stdin-filename', file] },
    node: true
  },
  {
    # The files whose rules it checks: the linters' configs and this script, the workflows and actions, AGENTS.md, the
    # rake tasks, the frontend's dependencies and the templates that load them, the packages, and the tests
    name: 'lint_test',
    files: %r{
      \A(
        \.rubocop\.yml | eslint\.config\.mjs | stylelint\.config\.mjs | script/lint | \.github/.+ | \.githooks/.+ | AGENTS\.md | Gemfile |
        tasks/.+\.rake | config/frontend_.+ | site/.+\.(html|md) | (cloudflare/)?package\.json | lib/.+\.rb | test/.+\.rb
      )\z
    }x,
    configs: /\A\z/,
    command: %w[bundle exec ruby -I test test/lint_test.rb],
    whole: true # runs on the checkout, never the files given
  }
].freeze

USAGE = "Usage: script/lint [--only #{LINTERS.map { |linter| linter[:name].downcase }.join('|')}] FILE... | --staged | --all".freeze

if (at = ARGV.index('--only'))
  only = ARGV.slice!(at, 2).last
  abort USAGE unless LINTERS.any? { |linter| linter[:name].downcase == only&.downcase }
end
mode = ARGV.first&.start_with?('--') ? ARGV.shift : nil
abort USAGE unless (mode.nil? && ARGV.any?) || (%w[--staged --all].include?(mode) && ARGV.empty?)

files =
  case mode
  when '--staged' then `git diff --cached --name-only --diff-filter=ACMR -z`.split("\0")
  when '--all' then []
  else ARGV.map { |f| f.delete_prefix('./') }
  end

# Each job is a command, its env and what to pipe to it
jobs = LINTERS.flat_map do |linter|
  next [] if only && linter[:name].downcase != only.downcase
  # lint_test runs this script in its own tests: not lint_test again, or it would never end
  next [] if linter[:whole] && ENV['LINT_TEST']

  all = mode == '--all' || files.any? { |f| f.match?(linter[:configs]) }
  mine = files.grep(linter[:files])
  next [] unless all || mine.any?

  # Only the versions package-lock.json installs: npx would otherwise fetch a missing linter, of any age
  if linter[:node] && !File.exist?("node_modules/.bin/#{linter[:name].downcase}")
    $stderr.write("#{linter[:name]} isn't installed, so run npm ci first\n")
    next [{ name: linter[:name], missing: true }]
  end
  if linter[:uv] && ENV['PATH'].split(File::PATH_SEPARATOR).none? { |dir| File.executable?(File.join(dir, 'uvx')) }
    $stderr.write("#{linter[:name]} runs with uvx, so install uv first (https://docs.astral.sh/uv/)\n")
    next [{ name: linter[:name], missing: true }]
  end

  env = linter[:env] || {}
  if linter[:whole]
    [{ name: linter[:name], command: linter[:command], env: env }]
  elsif all
    files_for_all = linter[:all].respond_to?(:call) ? linter[:all].call : linter[:all] || []
    [{ name: linter[:name], command: linter[:command] + files_for_all, env: env }]
  elsif mode == '--staged'
    # One run per file, given the staged version on stdin, so unstaged edits don't count
    mine.map do |f|
      { name: linter[:name], command: linter[:command] + linter[:stdin].call(f), env: env, stdin: Open3.capture2('git', 'show', ":#{f}").first }
    end
  else
    [{ name: linter[:name], command: linter[:command] + mine, env: env }]
  end
end

failed = jobs.select { |job| job[:missing] }.map { |job| job[:name] }
jobs.reject { |job| job[:missing] }.each do |job|
  output, status = Open3.capture2e(job[:env], *job[:command], stdin_data: job[:stdin] || '')
  next if status.success?

  failed << job[:name]
  puts output
end

# Not warn, which RUBYOPT=-W0 (QUIET, and so lint_test's run of this script) silences
if failed.any?
  $stderr.write("\nFailed: #{failed.uniq.join(', ')}\n")
  exit 1
elsif jobs.any?
  puts "Passed: #{jobs.map { |job| job[:name] }.uniq.join(', ')}"
end
